{
  "name": "kudos-board",
  "version": "0.1.0",
  "private": true,
  "description": "Team Kudos Board monorepo (NestJS API + Next.js App Router web app)",
  "scripts": {
    "build": "pnpm --filter ./apps/* run build",
    "test": "pnpm --filter ./apps/* run test",
    "typecheck": "pnpm --filter ./apps/* run typecheck",
    "dev": "pnpm --filter api run start:dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v"
  }
}
